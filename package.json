{
  "name": "@platypus/workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Local Angular, React, Vue and Node.js integration experiment.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^24.16.0 || >=26.0.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "start": "node scripts/start-local.mjs",
    "build": "npm run build --workspace @platypus/server && npm run build --workspace @platypus/analytics && npm run build --workspace @platypus/administration && npm run build --workspace @platypus/support && npm run build --workspace @platypus/shell",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:integration": "node --test scripts/integration.test.mjs",
    "serve:analytics": "node scripts/serve-local.mjs analytics",
    "serve:administration": "node scripts/serve-local.mjs administration",
    "preview": "node scripts/start-local.mjs --preview",
    "test:browser": "node scripts/browser-check.mjs",
    "test:independent-build": "node scripts/verify-independent-build.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:support": "node scripts/serve-local.mjs support",
    "start:server": "npm run start --workspace @platypus/server",
    "test:server": "npm run build --workspace @platypus/server && npm run test --workspace @platypus/server",
    "test:startup": "node --test scripts/workspace-processes.test.mjs",
    "aws:prepare": "node scripts/aws/prepare.mjs",
    "aws:plan": "node scripts/aws/plan.mjs",
    "aws:preview": "node scripts/aws/preview.mjs",
    "aws:validate": "node scripts/validate-aws.mjs",
    "test:aws": "node --test scripts/aws/*.test.mjs"
  },
  "devDependencies": {
    "@aws/cloudformation-validate": "1.15.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1",
    "vue-eslint-parser": "10.4.1"
  }
}
