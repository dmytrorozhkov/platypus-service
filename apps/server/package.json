{
  "name": "@platypus/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.16.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "node --test test/server.test.mjs test/lambda.test.mjs test/postgres-repository.test.mjs test/postgres-lifecycle.test.mjs test/postgres-data.test.mjs",
    "start:postgres": "node dist/postgres-main.js",
    "db:migrate": "node database/migrate-seed.mjs migrate",
    "db:seed": "node database/migrate-seed.mjs seed",
    "db:check": "node database/migrate-seed.mjs check",
    "test:postgres:integration": "node --test test/postgres-integration.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
