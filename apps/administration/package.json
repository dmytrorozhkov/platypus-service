    "vite": "8.3.5",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.14",
    "tailwindcss": "4.3.4",
    "@tailwindcss/vite": "4.3.4",
    "native-federation-vite": "0.2.0",
